{
  "manifestVersion": 1,
  "id": "rivetin-context-menu",
  "version": "0.5.9",
  "name": {
    "zh-CN": "资源右键菜单",
    "en-US": "Resource context menus"
  },
  "description": {
    "zh-CN": "资源列表多级右键菜单与虚拟机原生配置快捷入口，复用 CloudTower 官方菜单、对话框和确认流程。",
    "en-US": "Cascading resource-row menus and VM shortcuts reuse CloudTower native menus, dialogs and confirmation flows."
  },
  "author": "Rivetin contributors",
  "license": "MIT",
  "repository": "https://github.com/sephirothchang/rivetin",
  "homepage": "https://github.com/sephirothchang/rivetin/tree/main/plugins/rivetin-context-menu",
  "compatibility": {
    "schemaVersion": 2,
    "frameworkApi": 1,
    "frameworkMinVersion": "0.2.0",
    "frameworkMaxVersionExclusive": "0.3.0",
    "towerBuilds": [
      "4.9.0"
    ],
    "smtx": "none",
    "tower": "CloudTower 4.9.0 public DOM; framework 0.2 candidate, live validation pending."
  },
  "frontend": {
    "format": "rivetin-global-v1",
    "entry": "web/plugin.js"
  },
  "permissions": [
    "ui.context-menu"
  ],
  "locales": [
    "zh-CN",
    "en-US"
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "nativeActions": {
          "type": "boolean"
        },
        "resourceTypes": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "maxLength": 20,
            "enum": [
              "organization",
              "datacenter",
              "cluster",
              "host",
              "vm",
              "vmVolume",
              "disk",
              "nic",
              "vmGroup",
              "vmPlacementGroup",
              "vmNetwork",
              "systemNetwork",
              "vmSnapshot",
              "snapshotPlan",
              "vds"
            ]
          }
        }
      },
      "required": [
        "version",
        "enabled",
        "nativeActions",
        "resourceTypes"
      ]
    },
    "defaults": {
      "version": 1,
      "enabled": true,
      "nativeActions": true,
      "resourceTypes": [
        "organization",
        "datacenter",
        "cluster",
        "host",
        "vm",
        "vmVolume",
        "disk",
        "nic",
        "vmGroup",
        "vmPlacementGroup",
        "vmNetwork",
        "systemNetwork",
        "vmSnapshot",
        "snapshotPlan",
        "vds"
      ]
    }
  },
  "lifecycle": {
    "reset": "defaults",
    "uninstall": "retain-config"
  },
  "releaseNotes": {
    "zh-CN": "修复A/B/A后原生入口恢复，并严格限定单次准确原生reset边；外部排队导航和重复边仍使操作失效，不凭当前URL相等继续。保留退休、代次和身份守卫及自身失败提示。0.5.8本地候选未通过独审、未部署，0.5.9待真实环境测试。",
    "en-US": "Recover native entries after A/B/A using a single exact native reset edge. Queued external navigation and duplicate edges still cancel; current URL equality cannot establish ownership. Preserve retirement, generation and identity checks and visible failure diagnostics. The 0.5.8 local candidate was rejected and never deployed; 0.5.9 awaits real-environment testing."
  }
}
